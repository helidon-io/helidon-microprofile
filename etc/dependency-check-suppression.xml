        <notes><![CDATA[
   file name: jakarta.el-4.0.2.jar
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.glassfish.*/(jakarta\.el|jaxb-core|jaxb-runtime|osgi-resource-locator|txw2)@.*$
        </packageUrl>
        <cve>CVE-2024-9329</cve>
    </suppress>

